#!/usr/bin/env bpftrace
/*
 * usdt_trace.bt — 애플리케이션 정적 추적점(USDT)을 추적.
 * [개념] USDT = 프로그램/라이브러리에 미리 박아둔 '정적 추적점'. uprobe 보다 안정적이고 의미가 명확.
 * glibc 에는 pthread 관련 USDT(cond_broadcast 등)가 있다.
 * 실행:  cc -O2 -o /tmp/usdt_trigger usdt_trigger.c -lpthread ; /tmp/usdt_trigger &
 *        sudo bpftrace usdt_trace.bt
 * 목록:  sudo bpftrace -l 'usdt:/usr/lib/aarch64-linux-gnu/libc.so.6:*'
 */
usdt:/usr/lib/aarch64-linux-gnu/libc.so.6:libc:cond_broadcast {
    @broadcasts[comm] = count();
}
interval:s:1 { print(@broadcasts); }
