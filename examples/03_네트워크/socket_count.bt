#!/usr/bin/env bpftrace
/*
 * socket_count.bt — 어떤 프로세스가 소켓을 많이 만드나
 *
 * [무엇을 하나]
 *   socket() 시스템콜(네트워크 통신의 출발점)을 프로세스별로 세어 종료 시 정리해 보여준다.
 *   "네트워크를 많이 쓰는 프로세스"를 한눈에.
 *
 * [어떻게 도나]
 *   - tracepoint:syscalls:sys_enter_socket : 소켓 생성 시스템콜 진입점
 *   - @[comm] = count() : 프로세스 이름별 누적
 *
 * [실행]
 *   sudo bpftrace socket_count.bt        (다른 창에서 curl, ping 등 몇 번 → Ctrl-C 로 결과 확인)
 */

BEGIN {
    printf("소켓 생성 집계 중... (Ctrl-C 로 멈추면 결과가 나옵니다)\n");
}

tracepoint:syscalls:sys_enter_socket {
    @sockets[comm] = count();   // sockets = 프로세스별 소켓 생성 수
}
