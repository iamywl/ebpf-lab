#!/usr/bin/env bpftrace
/*
 * cpu_profile.bt — 지금 CPU 를 누가 쓰고 있나 (샘플링 프로파일링)
 *
 * [무엇을 하나]
 *   1초에 99번, 모든 CPU 에서 "지금 실행 중인 프로세스"를 찍어(샘플링) 누가 CPU 를 많이 먹는지 센다.
 *   플레임 그래프의 원리(주기적 샘플링→집계)를 가장 단순하게 체험.
 *
 * [어떻게 도나]
 *   - profile:hz:99 : CPU 마다 초당 99번 발생하는 타이머 이벤트 (49도, 999도 가능)
 *   - 그 순간의 comm 을 세면, 많이 찍힌 프로세스 = CPU 를 많이 쓰는 프로세스
 *   - 99 같은 '소수 비슷한' 빈도를 쓰는 이유: 주기적 작업과 박자가 겹쳐 편향되는 걸 피하려고
 *
 * [실행]
 *   sudo bpftrace cpu_profile.bt        (몇 초 두었다가 Ctrl-C → 프로세스별 샘플 수)
 *   부하를 주려면 다른 창에서:  yes > /dev/null   (확인 후 Ctrl-C 로 멈추기)
 *
 * [관련] 14주차(성능·프로파일링·플레임 그래프).
 */

BEGIN {
    printf("CPU 샘플링 중(초당 99회)... (Ctrl-C 로 멈추면 결과가 나옵니다)\n");
}

profile:hz:99 {
    @on_cpu[comm] = count();   // on_cpu = 프로세스별 CPU 점유 샘플 수
}
