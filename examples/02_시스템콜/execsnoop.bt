#!/usr/bin/env bpftrace
/*
 * execsnoop.bt — 새로 실행되는 모든 프로그램을 실시간으로 잡기
 *
 * [무엇을 하나]
 *   시스템에서 새 프로그램이 실행될 때마다 (시각, 부모PID, PID, 실행파일)을 한 줄씩 보여준다.
 *   보안 관측의 기본기 — "이 서버에서 방금 무엇이 실행됐나?"
 *
 * [어떻게 도나]
 *   - tracepoint:syscalls:sys_enter_execve : 프로그램 실행 시스템콜의 진입점
 *   - args.filename : 실행되는 파일 경로
 *
 * [실행]
 *   sudo bpftrace execsnoop.bt        (다른 창에서 ls, whoami 등을 실행 → 즉시 잡힘. Ctrl-C 종료)
 *
 * [관련] 9·13주차(시스템콜 관측·보안). 실제 BCC 도구 execsnoop-bpfcc 의 축소판.
 */

BEGIN {
    printf("%-8s %-16s %-6s %s\n", "시각", "실행한 프로세스", "PID", "실행 파일");
}

tracepoint:syscalls:sys_enter_execve {
    time("%H:%M:%S ");
    printf("%-16s %-6d %s\n", comm, pid, str(args.filename));
}
